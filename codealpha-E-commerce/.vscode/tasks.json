{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Django and open Chrome",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Start-Process chrome 'http://127.0.0.1:8000'; python manage.py runserver"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
